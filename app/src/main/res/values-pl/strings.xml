    <string name="notif_perm">Uprawnienia do powiadomień</string>
    <string name="notif_perm_desc">AppLock wymaga uprawnień do wyświetlania powiadomień, aby informować Cię na bieżąco i prawidłowo działać w tle. Dotknij „Dalej”, aby przyznać uprawnienia.</string>
