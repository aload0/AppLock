    <string name="welc_applock">Witamy w AppLock</string>
    <string name="welcome_desc">Chroń swoje aplikacje i prywatność dzięki AppLock. Przeprowadzimy Cię przez szybką konfigurację.</string>
    <string name="secure_apps">Zabezpiecz swoje aplikacje</string>
    <string name="secure_apps_desc">Chroń swoje prywatne aplikacje za pomocą zaawansowanych mechanizmów blokowania</string>
